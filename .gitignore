# ---------------------------------------------------------------
# Redline — .gitignore
# Rule of thumb: if a file holds a password, key, or anything that
# could let someone else act as you, it does NOT belong in git.
# Once a secret is pushed it lives in the history forever, even if
# you delete the file in a later commit.
# ---------------------------------------------------------------

# --- Secrets and environment files ---------------------------
# .env files hold API keys, database passwords, and similar.
# Ignore every variant, then allow the *example* file back in so
# new developers can see which names are needed (with no values).
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example

# Other common credential file shapes
# private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
*.crt
secrets.json
secrets.yml
secrets.yaml
credentials.json
# Google Cloud service-account keys
service-account*.json
gha-creds-*.json
.netrc
# can contain a package-publishing token
.npmrc
.yarnrc.yml
.pypirc
.htpasswd

# Cloud / tooling credential stores
.aws/
.azure/
.gcloud/
.terraform/
*.tfstate
*.tfstate.*
# often holds passwords
*.tfvars
.terraformrc
terraform.rc

# --- Dependencies ---------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bower_components/
jspm_packages/

# --- Next.js build output -------------------------------------
.next/
out/
build/
dist/
.swc/

# --- Testing and coverage -------------------------------------
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# --- Caches ---------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
.rollup.cache/
tsconfig.tsbuildinfo
*.tsbuildinfo
.npm/
.node_repl_history

# --- Hosting / deployment platforms ---------------------------
# contains project + organisation identifiers
.vercel/
.netlify/
.serverless/
.firebase/
.wrangler/
.sst/
.amplify/
.vscode-test/

# --- Databases and local data ---------------------------------
*.sqlite
*.sqlite3
*.db
/prisma/*.db
/prisma/*.db-journal
dump.rdb

# --- Logs -----------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Editor and OS noise --------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Misc -----------------------------------------------------
*.tgz
*.tar.gz
*.zip
.tmp/
tmp/
temp/
.history/
