# Copy this file to .env.local and fill in the values. .env.local is never
# committed. Leave a Supabase line empty and Redline still analyses pasted
# documents, but sign-in, the library and red lines are switched off.

# Key for OpenRouter, the service Redline sends documents to for analysis.
OPENROUTER_API_KEY=
# The OpenRouter model id Redline uses. Redline checks it against OpenRouter's model list on first use.
OPENROUTER_MODEL=

# Your Supabase project's address (Project Settings, API, Project URL).
NEXT_PUBLIC_SUPABASE_URL=
# Your Supabase project's public anon key (Project Settings, API). Safe in the browser; the database's access rules protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tests only. A confirmed Supabase test account the storage tests sign in as.
SUPABASE_TEST_EMAIL=
# Tests only. That test account's password.
SUPABASE_TEST_PASSWORD=
# Tests only. A second confirmed test account, a different person, for the check that one person cannot reach another's data.
SUPABASE_TEST_EMAIL_2=
# Tests only. The second test account's password.
SUPABASE_TEST_PASSWORD_2=
